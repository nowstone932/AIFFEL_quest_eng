        "import torch\n",
        "import random\n",
        "from tqdm import tqdm\n",
        "# 💡 1. 디바이스 정의 (GPU가 있으면 cuda, 없으면 cpu)\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "# --- Added code to re-instantiate transformer and related objects ---\n",
        "# Assuming Transformer class, SRC_VOCAB_SIZE, TGT_VOCAB_SIZE are defined in global scope\n",
        "transformer = Transformer(\n",
        "    n_layers=2,\n",
        "    d_model=512,\n",
        "    n_heads=8,\n",
        "    d_ff=2048,\n",
        "    src_vocab_size=SRC_VOCAB_SIZE,\n",
        "    tgt_vocab_size=TGT_VOCAB_SIZE,\n",
        "    pos_len=200,\n",
        "    dropout=0.2,\n",
        "    shared=True\n",
        ")\n",
        "\n",
        "# 💡 2. 에포크 시작 전, 모델을 GPU로 보냅니다. (딱 한 번만 실행됨)\n",
        "transformer = transformer.to(device) # Optimizer가 생성되기 전에 모델을 장치로 이동\n",
        "\n",
        "# Assuming LearningRateScheduler and torch.nn are defined in global scope\n",
        "import torch.nn as nn\n",
        "optimizer = torch.optim.Adam(\n",
        "    transformer.parameters(), # 이제 optimizer는 GPU 파라미터에 연결됩니다.\n",
        "    lr=0,\n",
        "    betas=(0.9, 0.98),\n",
        "    eps=1e-9\n",
        ")\n",
        "learning_rate = LearningRateScheduler(optimizer, d_model=512)\n",
        "\n",
        "loss_object = nn.CrossEntropyLoss(ignore_index=0, reduction='none')\n",
        "# --- End of added code ---\n",
        "\n",
        "BATCH_SIZE = 64\n",
        "EPOCHS = 20\n",
        "\n",
        "examples = [\n",
        "    \"오바마는 대통령이다.\",\n",
        "    \"시민들은 도시 속에 산다.\",\n",
        "    \"커피는 필요 없다.\",\n",
