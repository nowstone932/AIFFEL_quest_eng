        "import torch.nn as nn\n",
        "\n",
        "# [추가할 코드] 손실 함수 객체를 정의합니다.\n",
        "# 패딩 토큰(0)은 무시하고, 마스킹 연산을 위해 수치를 결합하지 않고(none) 그대로 반환합니다.\n",
        "loss_object = nn.CrossEntropyLoss(ignore_index=0, reduction='none')\n",
        "\n",
        "def loss_function(real, pred):\n",
        "    # 1. 정답(real)에서 패딩(0)이 아닌 부분을 마스킹합니다.\n",
        "    mask = (real != 0)\n",
        "\n",
        "    # 2. CrossEntropyLoss가 계산할 수 있도록 차원을 정렬합니다.\n",
        "    # pred 채널(단어 차원)을 마지막에서 클래스로 인식할 수 있도록 펼쳐줍니다.\n",
        "    # pred: [Batch, Seq_Len, Vocab_Size] -> [Batch * Seq_Len, Vocab_Size]\n",
        "    pred_flat = pred.contiguous().view(-1, pred.size(-1))\n",
        "\n",
        "    # real: [Batch, Seq_Len] -> [Batch * Seq_Len]\n",
        "    real_flat = real.contiguous().view(-1)\n",
        "\n",
        "    # 3. loss_object에 (예측값, 정답) 순서로 펼쳐진 데이터를 전달합니다.\n",
        "    loss_ = loss_object(pred_flat, real_flat)\n",
        "\n",
        "    # 4. 마스크를 1차원으로 펼쳐서 손실 값에 곱해줍니다.\n",
        "    mask = mask.view(-1).float()\n",
        "    loss_ *= mask\n",
        "\n",
        "    # 5. 마스킹되지 않은 실제 단어 수만큼 나누어 평균 손실을 구합니다.\n",
        "    return loss_.sum() / mask.sum()\n",
        "\n",
        "print(\"슝~\")"
      ]
    },
